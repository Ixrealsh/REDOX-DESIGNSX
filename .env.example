NEXT_PUBLIC_SHOPIFY_DOMAIN=redox-design.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxx
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=https://redoxdesign.com
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=100
NEXT_PUBLIC_ALGOLIA_APP_ID=XXXXXXXXXX
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=xxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=redoxdesign

# Paystack API Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Admin Authentication
ADMIN_EMAIL=admin@redoxdesignx.com
ADMIN_PASSWORD=redox123

# SMS Notification (Hubtel)
# Server-only. Never prefix these with NEXT_PUBLIC_ - that would inline them into
# the client bundle. Sent to Hubtel as HTTP Basic auth, never as query parameters.
HUBTEL_CLIENT_ID=your_hubtel_client_id_here
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_here
# Max 11 characters, and must be pre-approved in your Hubtel dashboard.
HUBTEL_SENDER_ID=RedoxDesign
ADMIN_PHONE_NUMBER=0558058348
